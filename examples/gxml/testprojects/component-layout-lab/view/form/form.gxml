<!-- 组件布局实验台 · 表单视图。
     ViewModel 指向**另一个包**（model.Lab），产物落在本目录的 package form，
     类型定义留在 model 包；入口 cmd/lab 把同一个 *model.Lab 交给本视图与 report 视图。
     只用基线已支持语法：Def/Slot、Grid、Text/Input/Button、If 不在本页使用；
     不引入 ThemeRef、不使用 <Expanded>、不假设 Def 能跨文件导入（Def 定义在本文件内）。 -->
<Goxml Version="1" ViewModel="model.Lab">
  <Defs>
    <!-- LabCell：typed props + 默认值。第二个实例显式传入 Badge 覆盖默认值，
         第一个实例不传 —— 「默认值覆盖」由此有运行时判据：
         徽标是静态文本（不进文本缓存槽位），但它的宽度会推动同一行里紧随其后的
         探针按钮；两个实例的探针按钮 X 坐标差 = 徽标文本宽度差。 -->
    <Def Name="LabCell" Props="Label:string; Value:string; Badge:string=默认">
      <Column Gap="4">
        <Text Value="{Label}" Background="#E8EEF7" Padding="3"/>
        <Text Value="{Value}" Background="#FFFFFF" Padding="3"/>
        <Row Gap="0" Align="Center">
          <Text Value="{Badge}" Background="#FFF7E0" Padding="3"/>
          <Button Text="探" Click="Probe" Background="#EDE7F6" Padding="3"/>
        </Row>
      </Column>
    </Def>

    <!-- LabPanel：color prop + 默认值 + 默认插槽。面板甲传 Tone 覆盖默认背景色，
         面板乙不传子节点（空插槽）。 -->
    <Def Name="LabPanel" Props="Title:string; Tone:color=#F3F3F3">
      <Column Padding="12" Gap="6" Background="{Tone}">
        <Text Value="{Title}" Background="#E6E6E6" Padding="3"/>
        <Slot/>
      </Column>
    </Def>
  </Defs>
  <Page Route="/lab/form">
    <Column Padding="12" Gap="8">
      <Text Value="组件布局实验台 · 表单" Background="#EFEFEF" Padding="4"/>
      <!-- Grid：固定 72dp + 弹性 + 固定 96dp；子项不设 Width（列定义拥有单元格宽度）。
           单元格里放 Input/Button，绑定与事件按控件各自独立接线。 -->
      <Grid Columns="72 * 96" Gap="8" Align="Center">
        <Text Value="甲"/>
        <Input Value="{DraftA}" ValueChanged="OnDraftAChanged" Submit="OnSubmitA" Background="#FFF7E6"/>
        <Button Text="应用甲" Click="ApplyA" Background="#E8F5E9" Padding="3"/>
        <Text Value="乙"/>
        <Input Value="{DraftB}" ValueChanged="OnDraftBChanged" Submit="OnSubmitB" Background="#EEF5FF"/>
        <Button Text="应用乙" Click="ApplyB" Background="#E3F2FD" Padding="3"/>
      </Grid>
      <!-- 面板甲：插槽内容是一个真实按钮，点它只会增加 SlotAClicks；
           显式传 Tone 覆盖默认背景色。 -->
      <LabPanel Title="面板甲（带插槽）" Tone="#FFF8E1">
        <Button Text="插槽按钮甲" Click="SlotA" Background="#FFF3E0" Padding="3"/>
      </LabPanel>
      <!-- 面板乙：同一个 Def，不传子节点 —— 空插槽（用默认 Tone）。 -->
      <LabPanel Title="面板乙（空插槽）"/>
      <!-- 同一个 Def 两次调用参数不同：实例甲用默认徽标，实例乙显式覆盖。 -->
      <LabCell Label="单元甲" Value="{SavedA}"/>
      <LabCell Label="单元乙" Value="{SavedB}" Badge="覆盖徽标文本"/>
    </Column>
  </Page>
</Goxml>
